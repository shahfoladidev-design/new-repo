NEXT_PUBLIC_SUPABASE_URL=https://tvazkvptzmnfxnrnuscs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public site URL used for sitemap, Open Graph, and canonical links
NEXT_PUBLIC_SITE_URL=https://www.shahfoladi.com

# Optional — Google Search Console HTML-tag verification code (content value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abcdefghijklmnopqrstuvwxyz

# Required for admin OTP password reset and payment processing (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for Supabase admin-password-reset edge function (also set in Edge Function secrets)
ADMIN_EDGE_SECRET=

# Optional HesabPay overrides (primary config is in Admin → Settings → HesabPay)
# HESABPAY_ENV=sandbox
# HESABPAY_SANDBOX_API_BASE_URL=https://api-sandbox.hesab.com
# HESABPAY_PRODUCTION_API_BASE_URL=https://api.hesab.com
# HESABPAY_API_KEY=
# HESABPAY_MERCHANT_ID=
# HESABPAY_MERCHANT_PIN=
# HESABPAY_WEBHOOK_SECRET=
# HESABPAY_ALLOWED_CHECKOUT_HOSTS=api.hesab.com,sandbox-api.hesab.com,pay.hesab.com

# Optional — admin booking + password-reset emails
RESEND_API_KEY=
# Must use an address on your verified Resend domain (default: bookings@send.shahfoladi.com)
RESEND_FROM_EMAIL=Shah Foladi <bookings@send.shahfoladi.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
